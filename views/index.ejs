<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Items</h1>
    <hr>
    <form method="post" class="row">
        <% goods.forEach(item=> { %>
            <div class="card">
                <h3>
                    <%= item.name %>
                </h3>
                <img src="<%= item.image %>" alt="<%= item.name %>">
                <hr>
                <p>Price: <%= item.price %>
                </p>
                <button type="submit" name="productId" value="<%= item.id %>">Add to Cart</button>
            </div>
            <% }); %>
    </form>

    <% cart.forEach(item=> { %>
        <div class="card">
            <h3>
                <%= item.name %>
            </h3>
            <img src="<%= item.image %>" alt="<%= item.name %>">
            <hr>
            <p>Price: <%= item.price %>
            </p>
        </div>
        <% }); %>


</body>

</html>